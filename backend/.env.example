PORT=8787
APP_BASE_URL=http://localhost:8787

# Set FIXTURE_MODE=true to skip live AssemblyAI/OpenAI and return canned transcripts
FIXTURE_MODE=true

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres


# Provider keys — server only, never ship to iOS
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
OPENAI_API_KEY=

# Webhook auth shared secret (AssemblyAI webhook_auth_header_value)
WEBHOOK_AUTH_HEADER_NAME=X-Afterna-Webhook-Secret
WEBHOOK_AUTH_SECRET=change-me

# Quotas (also exposed via GET /v1/config)
BASE_FREE_MINUTES=60
AI_DAILY_LIMIT=30
EXTRACT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
ASK_MODEL=gpt-4.1-mini
